<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;x64;ARM64</Platforms>
    <AssemblyName>dl2vhd</AssemblyName>
    <RootNamespace>DeviceLayoutToVhd</RootNamespace>
    <Version>1.0.4</Version>
    <Company>WinStory 2026</Company>
    <Product>WSK Tools</Product>
    <Copyright>Copyright (C) 2026 WinStory</Copyright>
    <Description>dl2vhd - Create VHD/VHDX from DeviceLayout XML</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Core" Version="1.0.51" />
    <PackageReference Include="LTRData.DiscUtils.Ntfs" Version="1.0.51" />
    <PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.51" />
    <PackageReference Include="LTRData.DiscUtils.Vhd" Version="1.0.51" />
    <PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.51" />
  </ItemGroup>
</Project>
